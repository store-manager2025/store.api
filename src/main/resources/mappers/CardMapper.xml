<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.project.storemanager_api.repository.CardRepository">

    <insert id="saveCard">
        INSERT INTO cards
            (card_company, payment_id, card_number)
        VALUES
            (#{cardCompany}, #{paymentId}, #{cardNumber})
    </insert>


</mapper>