<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.project.storemanager_api.repository.PaymentDetailRepository">

    <insert id="savePayInfo">
        INSERT INTO payment_detail
            (payment_id, paid_money, payment_type)
        VALUES
            (#{paymentId}, #{paidMoney}, #{paymentType})
    </insert>

</mapper>